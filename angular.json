{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend.kellyAcademy": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "assets/pdfjs"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/cmaps",
                "output": "assets/pdfjs/cmaps"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/standard_fonts",
                "output": "assets/pdfjs/standard_fonts"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/wasm",
                "output": "assets/pdfjs/wasm"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend.kellyAcademy:build:production"
            },
            "development": {
              "buildTarget": "frontend.kellyAcademy:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "configurations": {
            "evidencia": {
              "watch": false,
              "coverage": true,
              "coverageInclude": [
                "src/app/**/*.ts"
              ],
              "coverageReporters": [
                "text-summary",
                "html",
                "json-summary"
              ],
              "reporters": [
                [
                  "junit",
                  {
                    "outputFile": "reports/junit.xml"
                  }
                ],
                "verbose"
              ]
            }
          }
        }
      }
    }
  }
}
